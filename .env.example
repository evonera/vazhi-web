# Public website origin and the Convex HTTP origin (never store provider secrets here).
VITE_SITE_URL=http://localhost:5173
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
VITE_TURNSTILE_SITE_KEY=

# Used locally by the Convex CLI to generate and typecheck `convex/_generated`.
# Keep the concrete deployment value in .env.local, never Git.
# CONVEX_DEPLOYMENT=dev:your-deployment

# Configure these with `npx convex env set`, never in this file.
# BETTER_AUTH_SECRET=
# SITE_URL=
# APPLE_SERVICE_ID=
# APPLE_CLIENT_SECRET=
# APPLE_BUNDLE_ID=com.evonera.vazhi
# GOOGLE_PLACES_API_KEY=
# GOOGLE_ROUTES_API_KEY=
# EDGE_INGRESS_SIGNING_SECRET=
# RATE_LIMIT_SALT=
# VAZHI_ENVIRONMENT=development

# Configure these as Cloudflare Worker secrets/variables as appropriate.
# CONVEX_HTTP_URL=https://your-deployment.convex.site
# EDGE_INGRESS_SIGNING_SECRET=
# RATE_LIMIT_SALT=
# TURNSTILE_SECRET_KEY=
# VAZHI_ENVIRONMENT=development
