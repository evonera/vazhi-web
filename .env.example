# Public website origin and the Convex HTTP origin (never store provider secrets here).
VITE_SITE_URL=http://localhost:5173
# Written by `npx convex dev`; used by auth and HTTP actions.
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
# Public site key only; set the matching secret in the Cloudflare Worker.
VITE_TURNSTILE_SITE_KEY=
# Legacy preview compatibility only. Prefer VITE_CONVEX_SITE_URL for new environments.
# VITE_CONVEX_HTTP_URL=https://your-deployment.convex.site

# Used locally by the Convex CLI to generate and typecheck `convex/_generated`.
# Keep the concrete deployment value in .env.local, never Git.
# CONVEX_DEPLOYMENT=dev:your-deployment

# Configure Convex secrets with `npx convex env set`, never in this file.
# VAZHI_ENVIRONMENT=production  # only the named development deployment may omit Turnstile/rate-limit secrets
# BETTER_AUTH_SECRET=
# SITE_URL=
# APPLE_SERVICE_ID=
# APPLE_CLIENT_SECRET=
# APPLE_BUNDLE_ID=com.evonera.vazhi
# GOOGLE_PLACES_API_KEY=
# EDGE_INGRESS_SIGNING_SECRET=  # set in both Convex and the Cloudflare Worker
# RATE_LIMIT_SALT=
# AI_CLOUD_API_KEY=         # OpenAI-compatible provider secret
# AI_CLOUD_API_URL=         # optional; defaults to OpenAI chat completions
# AI_CLOUD_MODEL=           # optional; defaults to gpt-4.1-mini
# REVENUECAT_WEBHOOK_SIGNING_SECRET=  # HMAC secret; configure only with `npx convex env set`
# REVENUECAT_WEB_PURCHASE_LINK_PRODUCTION=  # Dashboard Production URL, https://pay.rev.cat/<token>; never use Sandbox here

# Cloudflare Worker secrets (set with `wrangler secret put`, never here):
# TURNSTILE_SECRET_KEY=
# EDGE_INGRESS_SIGNING_SECRET=  # must match the Convex value
